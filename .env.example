# Optional. All variables are optional - the site works without any of them.

# Your final public domain, no trailing slash. Used for share-preview (Open Graph) URLs.
# On Vercel this is detected automatically; set it only if you use a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional background music. Put an .mp3 in /public/audio and point to it here.
# If empty, the music button is not shown at all.
# NEXT_PUBLIC_MUSIC_SRC=/audio/music.mp3
